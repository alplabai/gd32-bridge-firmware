# Build artifacts from the CMake builds. The trailing `*` catches every
# out-of-tree name in use here, not just the literal `build/`: this repo's
# own `build-tests/` (host unit suites), CONTRIBUTING.md's documented
# `build/stub`, and sibling forms such as `build-gd32/`.
build*/

# Cygwin/MSYS crash dumps -- `git add -A` on the Windows bench has swept these
# into history in sibling repos.
*.stackdump

# Python bytecode cache. `tests/gen_protocol_vectors.py` and
# `python3 -m compileall -q tests tools` both create these under tests/ and
# tools/.
__pycache__/

# .github/workflows/mcuboot-size.yml checks MCUboot out here (and CI's own
# build output lives under $RUNNER_TEMP, never in the tree) -- ignored so a
# local rerun of the same steps doesn't leave an untracked source checkout
# or stray ELFs/maps sitting under tools/mcuboot-size/.
/.mcuboot-src/
tools/mcuboot-size/build/
tools/mcuboot-size/**/*.elf
tools/mcuboot-size/**/*.map
tools/mcuboot-size/**/*.o
